# Lists required environment variable names without real values.
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=llm_gateway
DATABASE_URL=postgresql+asyncpg://llm_gateway:local_dev_password@localhost:5432/llm_gateway
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6380/0
FAKE_DELAY_MS=0
SERVER_TIMING=false
ACCOUNTING_BUFFER_SIZE=10000

# Optional self-hosted provider; the base URL includes /v1.
# VLLM_BASE_URL=http://gpu-host:8000/v1
# VLLM_API_KEY=
VLLM_MAX_CONCURRENCY=16
REQUEST_DEADLINE_SECONDS=120
